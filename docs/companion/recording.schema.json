{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findspot.app/schema/companion-recording-v1.json",
  "title": "FindSpot Companion Recording",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "producer", "recordingUuid", "contentHash",
    "createdAtUtc", "startedAtUtc", "stoppedAtUtc", "state",
    "interruptionReason", "segments"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "platform"],
      "properties": {
        "name": { "const": "FindSpot Companion" },
        "version": { "type": "string", "minLength": 1, "maxLength": 50 },
        "platform": { "enum": ["android", "ios"] }
      }
    },
    "recordingUuid": { "type": "string", "format": "uuid" },
    "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "createdAtUtc": { "$ref": "#/$defs/utcMilliseconds" },
    "startedAtUtc": { "$ref": "#/$defs/utcMilliseconds" },
    "stoppedAtUtc": {
      "oneOf": [{ "$ref": "#/$defs/utcMilliseconds" }, { "type": "null" }]
    },
    "state": { "enum": ["stopped", "interrupted"] },
    "interruptionReason": {
      "enum": [null, "process_killed", "device_reboot", "permission_revoked", "location_disabled"]
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/segment" }
    }
  },
  "$defs": {
    "utcMilliseconds": { "type": "integer", "minimum": 0 },
    "nullableNonNegative": {
      "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segmentIndex", "startedAtUtc", "endedAtUtc", "observations"],
      "properties": {
        "segmentIndex": { "type": "integer", "minimum": 0 },
        "startedAtUtc": { "$ref": "#/$defs/utcMilliseconds" },
        "endedAtUtc": {
          "oneOf": [{ "$ref": "#/$defs/utcMilliseconds" }, { "type": "null" }]
        },
        "observations": {
          "type": "array",
          "items": { "$ref": "#/$defs/trackPoint" }
        }
      }
    },
    "trackPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "sequence", "timestampUtc", "monotonicTimestampNs",
        "receivedTimestampUtc", "latitude", "longitude", "altitudeM",
        "horizontalAccuracyM", "verticalAccuracyM", "headingDegrees",
        "speedMps", "provider"
      ],
      "properties": {
        "type": { "const": "trackPoint" },
        "sequence": { "type": "integer", "minimum": 0 },
        "timestampUtc": { "$ref": "#/$defs/utcMilliseconds" },
        "monotonicTimestampNs": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9]+$" },
            { "type": "null" }
          ]
        },
        "receivedTimestampUtc": { "$ref": "#/$defs/utcMilliseconds" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "altitudeM": { "oneOf": [{ "type": "number" }, { "type": "null" }] },
        "horizontalAccuracyM": { "$ref": "#/$defs/nullableNonNegative" },
        "verticalAccuracyM": { "$ref": "#/$defs/nullableNonNegative" },
        "headingDegrees": {
          "oneOf": [
            { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
            { "type": "null" }
          ]
        },
        "speedMps": { "$ref": "#/$defs/nullableNonNegative" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    }
  }
}
